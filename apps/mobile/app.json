{
  "expo": {
    "name": "DIPONeoCare",
    "slug": "DIPONeoCare",
    "version": "1.0.0",
    "scheme": "diponeocare",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "extra": {
        "eas": {
          "projectId": "f8b3dee9-6cc9-49a6-8a28-737be8b5f569"
        }
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartvision.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Aplikasi memerlukan akses jaringan lokal untuk menampilkan siaran langsung kamera dari perangkat Smart Vision."
      }
    },
    "android": {
      
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D9E75"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "usesCleartextTraffic": true,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan Smart Vision mengakses kamera untuk scan QR perangkat"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1D9E75",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f8b3dee9-6cc9-49a6-8a28-737be8b5f569"
      }
    },
    "owner": "sabiqtekkom23"
  }
}
